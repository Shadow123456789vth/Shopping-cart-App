# Copy to .env.local (gitignored) and set your instance.
SN_INSTANCE_URL=https://dev402340.service-now.com

# OAuth client from System OAuth > Application Registry > "Create an OAuth API endpoint for external clients".
# Leave empty to use Basic auth for everything.
SN_CLIENT_ID=
SN_CLIENT_SECRET=
# client_credentials (default): API calls run as the app's OAuth Application User, and shoppers' passwords are
#   checked once at login. password: each shopper gets their own token (needs the password grant enabled).
SN_OAUTH_GRANT=client_credentials
# Signs login sessions in client_credentials mode. Defaults to SN_CLIENT_SECRET.
SN_SESSION_SECRET=
