# Copy to .env.local (gitignored) and set your instance.
SN_INSTANCE_URL=https://dev402340.service-now.com

# The only account that can sign in. The login form must match these, and the server makes every
# ServiceNow call with them. They stay on the server; the browser only gets a signed session.
SN_USERNAME=
SN_PASSWORD=
# Signs login sessions. Defaults to SN_PASSWORD.
SN_SESSION_SECRET=
